# Konfigurasi backend ScoutML
# Salin file ini menjadi `.env` lalu sesuaikan nilainya.

APP_NAME=ScoutML API
APP_VERSION=1.0.0

# Origin yang diizinkan mengakses API (pisahkan dengan koma).
# Gunakan "*" saat pengembangan agar aplikasi Flutter web bisa mengakses.
CORS_ORIGINS=*

# Folder tempat artefak model ML kamu disimpan (relatif terhadap backend/).
# Isi folder ini dengan model KNN + scaler hasil training kamu.
ARTIFACTS_DIR=app/ml/artifacts

# File dataset pemain (JSON) yang dipakai sebagai sumber metadata pemain.
PLAYERS_FILE=app/data/players.json
